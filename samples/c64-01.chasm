;;; C-64 program, installed at $0801, includes BASIC bytes to jump to our asm code
;;; flashes border during the raster interrupt
.def CTRL1  		$d011
.def RASTER 		$d012
.def IRQ_MSK		$d019
.def IRQ_EN			$d01A
.def BORDER 		$d020

.def IRQ_VEC_LOW	$0314
.def IRQ_VEC_HIGH	$0315

; place this code at $0801
.org $0801
; that runs the BASIC SYS(2064) command to start our assembly code
.data $0c $08 $0a $00 $9e $32 $30 $36 $34 $00 $00 $00 $00 $00 $00
; addr is now $8010 (2064), which is where basic will start executing

jmp setupIRQ

; addr here is $0801 + 3 (sizeof jmp)
customIRQ:

; ack the int
asl IRQ_MSK

inc BORDER

; exit back to kernal irq handler
jmp $ea31

setupIRQ:

sei

;;; enable raster interrupts from vic-ii
lda #$7f	; turn off CIA 1 timer interrupts
sta $dc0d
lda $dc0d	; ack pending CIA ints
lda $dd0d

;lda #$1b	; bit 7 of raster ctrl1 *clear* for lines 0-255
;lda #%00011011 ; $1b in binary
lda #%10011011  ; bit 7 of ctrl1 *set* for lines over 255
sta CTRL1

lda #$20	; trigger int at scanline 287/$11f ($ff+$20 - "bit 8" of RASTER is in bit 7 of CTRL1)
sta RASTER

;;; redirect IRQ vector to custom handler
lda #<customIRQ		; low byte of customIRQ address
sta IRQ_VEC_LOW
lda #>customIRQ		; high byte of customIRQ address
sta IRQ_VEC_HIGH

lda #01		; enable raster int flag
sta IRQ_EN

cli			; re-enable interrupts

start:
nop
jmp start

